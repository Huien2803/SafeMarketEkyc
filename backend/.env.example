# ============================================
# SafeMarket Backend - Environment Variables
# Copy file này thành .env và điền giá trị thật
# ============================================

# Server
PORT=3000
NODE_ENV=development

# SQL Server (chạy ../eKYC Market.sql + db/create-app-user.sql trong SSMS trước)
# LocalDB (SSMS: (localdb)\MSSQLLocalDB):
DB_HOST=(localdb)\MSSQLLocalDB
DB_PORT=1433
# SQL Server full trên máy: DB_HOST=localhost
DB_USERNAME=safemarket_api
DB_PASSWORD=SafeMarket@2026
DB_DATABASE=SafeMarketDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# JWT - đổi secret này khi deploy thật
JWT_SECRET=safemarket_dev_secret_change_me_in_production_2026
JWT_EXPIRES_IN=7d

# FPT.AI eKYC (xin tại https://fpt.ai/portal)
FPT_AI_API_KEY=YOUR_FPT_AI_API_KEY
FPT_AI_OCR_URL=https://api.fpt.ai/vision/idr/vnm
FPT_AI_FACE_MATCH_URL=https://api.fpt.ai/dmp/facematch/v1/

# Payment (sandbox - lấy sau khi đăng ký VNPay/MoMo)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay-return
