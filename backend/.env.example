# ============================================
# SafeMarket Backend - Environment Variables
# Copy file này thành .env và điền giá trị thật
# ============================================

# Server
PORT=3000
NODE_ENV=development

# Production: HTTPS terminate tại Nginx/Caddy → proxy tới Nest (HTTP nội bộ).
# CORS_ORIGINS bắt buộc khi NODE_ENV=production (vd: https://app.example.com)
CORS_ORIGINS=
# Bật Swagger trên production chỉ khi cần debug (mặc định tắt)
ENABLE_SWAGGER=false

# SQL Server Database (chạy script db/create-app-user.sql trong SSMS trước)
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=safemarket_api
DB_PASSWORD=SafeMarket@2026
DB_DATABASE=SafeMarketDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# JWT — production: secret ≥32 ký tự, không dùng giá trị mẫu
JWT_SECRET=safemarket_dev_secret_change_me_in_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email OTP — Gmail: bật 2FA → tạo App Password (16 ký tự).
# https://myaccount.google.com/apppasswords
# MAIL_FROM để trống → tự dùng SMTP_USER.
# Dev: SMTP_ALLOW_DEV_FALLBACK=true → chưa có SMTP vẫn hiện OTP trên app.
# Production: luôn cần SMTP_USER + SMTP_PASS (fallback bị tắt).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email_cua_ban@gmail.com
SMTP_PASS=app_password_16_ky_tu
MAIL_FROM=
SMTP_ALLOW_DEV_FALLBACK=true

# FPT.AI eKYC (dự phòng)
FPT_AI_API_KEY=
FPT_AI_OCR_URL=https://api.fpt.ai/vision/idr/vnm
FPT_AI_FACE_MATCH_URL=https://api.fpt.ai/dmp/checkface/v1/

# VNPT eKYC OCR — ưu tiên. Không commit secret lên GitHub.
EKYC_OCR_PROVIDER=vnpt
VNPT_EKYC_BASE_URL=https://api.idg.vnpt.vn
VNPT_TOKEN_ID=
VNPT_TOKEN_KEY=
VNPT_ACCESS_TOKEN=
# -1: CMND/CCCD thường | 9: CCCD chip (tùy gói VNPT)
VNPT_DOC_TYPE=-1

# Phiên eKYC (kiểu ngân hàng): TTL phút, ngưỡng face-match, điểm Face ID tối thiểu
EKYC_SESSION_TTL_MIN=30
EKYC_FACE_MATCH_THRESHOLD=0.72
EKYC_MIN_RECOGNITION_POINTS=8
# auto = so khớp thật VNPT/FPT; lỗi API thì chặn (không tự cho khớp)
# fpt = bắt buộc FPT Face Match
# attested = CHỈ demo: bỏ qua so khớp CCCD — không dùng khi bảo vệ
EKYC_FACE_MATCH_MODE=auto

# Khiếu nại đơn hàng: số ngày tối đa kể từ giao/thanh toán (quá hạn → HTTP 403)
DISPUTE_WINDOW_DAYS=3


# Dev — backend tự adb reverse khi khởi động (CHAY-BACKEND.bat)
DEV_AUTO_PHONE_SETUP=true
# Ghi đè IP LAN nếu cần (để trống = tự phát hiện)
DEV_LAN_HOST=

# Production: bắt buộc cấu hình; simulate-pay bị tắt.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay-return
VNPAY_IPN_URL=http://localhost:3000/api/payments/vnpay-ipn
